{
  "extends": "./tsconfig.app.json",
  // The tests plus the sources they import: a project has to list every file it
  // pulls in, so this one checks the whole package with Node types added.
  // scripts/ is the theme generator's CLI, Node-only like the tests and with
  // the same need for the Node types tsconfig.app.json deliberately excludes.
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "vitest.setup.ts", "scripts/**/*"],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
