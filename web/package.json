{
  "name": "@ostendorf-cloud/web-kit",
  "version": "0.1.0",
  "description": "Vue design token contract, theming and components for the Go plus Vue web framework",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/base.css",
    "./themes/*.css": "./src/styles/themes/*.css"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "theme:generate": "node scripts/generate-theme.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "reka-ui": "^2.11.0"
  },
  "pnpm": {
    "overrides": {
      "@testing-library/dom": "^10"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
